{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed wagering processor: wallets, immutable ledger, persistent idempotency, SQS inbox and transactional outbox.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/entrypoints/api.ts",
    "dev:consumer": "bun --watch src/entrypoints/consumer.ts",
    "dev:outbox-worker": "bun --watch src/entrypoints/outbox-worker.ts",
    "dev:reference-worker": "bun --watch src/entrypoints/reference-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/src/entrypoints/api.js",
    "start:consumer": "bun dist/src/entrypoints/consumer.js",
    "start:outbox-worker": "bun dist/src/entrypoints/outbox-worker.js",
    "start:reference-worker": "bun dist/src/entrypoints/reference-worker.js",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:money": "bun scripts/verification/check-money.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency && bun run test:fault",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test --timeout 60000 ./test/integration",
    "test:concurrency": "bun test --timeout 180000 ./test/concurrency",
    "test:fault": "bun test --timeout 180000 ./test/fault-injection",
    "test:e2e": "bun run build && bun test --timeout 180000 ./test/e2e",
    "test:load": "bun scripts/load-test/load-test.ts",
    "migration:up": "bun src/entrypoints/migrate.ts up",
    "migration:down": "bun src/entrypoints/migrate.ts down",
    "migration:status": "bun src/entrypoints/migrate.ts status",
    "queues:bootstrap": "bun src/entrypoints/bootstrap-queues.ts",
    "demo": "bun scripts/demo/demo.ts",
    "verify": "bun run lint && bun run typecheck && bun run check:money && bun run build && bun run test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1150.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "decimal.js": "10.6.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.6.7",
    "@prometheus-io/client": "0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "@types/express": "5.0.6",
    "@types/pg": "8.15.6",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.20.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "@mikro-orm/migrations": "6.6.17"
  },
  "overrides": {
    "umzug": "3.8.3"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "sprintf-js@1.0.3": "patches/sprintf-js@1.0.3.patch"
  }
}
