# Copy to .env to override the local defaults used by docker-compose.yml.
# Every value below is a LOCAL DEVELOPMENT default; never reuse them anywhere else.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=wagering
# Schema owner: used only by the `migrations` job.
POSTGRES_OWNER_USER=wagering_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
# Least-privilege runtime login (member of role wagering_app), used by every service.
APP_DB_USER=wagering_service
APP_DB_PASSWORD=change-me-service

# --- LocalStack ----------------------------------------------------------------
# localstack/localstack:4.14.0 is the last community image that runs without a
# token. To use a newer calendar-versioned image, set both variables below.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0
LOCALSTACK_AUTH_TOKEN=

# --- Edge ----------------------------------------------------------------------------
# Host port of nginx (the only published port). Change it if 8080 is already taken.
API_PUBLIC_PORT=8080

# --- Application -------------------------------------------------------------------
LOG_LEVEL=info
ACCEPTED_CURRENCIES=BRL
# Log level of the test/tooling container (silent keeps test output readable).
TEST_LOG_LEVEL=silent

# Pending-reference retry policy (exponential backoff, whichever limit comes first)
REFERENCE_RETRY_INITIAL_MS=2000
REFERENCE_RETRY_MAX_MS=300000
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL_MS=3600000

# SQS consumer
SQS_VISIBILITY_TIMEOUT_SECONDS=30
# Real processing attempts per message before the consumer moves it to the DLQ
CONSUMER_MAX_ATTEMPTS=5
# Queue redrive, only a safety net: must be >= CONSUMER_MAX_ATTEMPTS * SQS_MAX_MESSAGES (10)
SQS_MAX_RECEIVE_COUNT=100

# --- Observability profile -------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Host development (optional) ---------------------------------------------------------
# Only for running services on the host with Bun against docker-compose.dev.yml.
# Bun loads .env automatically; uncomment and keep the passwords in sync above.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wagering
# DB_USER=wagering_service
# DB_PASSWORD=change-me-service
# DB_MIGRATION_USER=wagering_owner
# DB_MIGRATION_PASSWORD=change-me-owner
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
